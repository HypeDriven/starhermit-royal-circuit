# Generated by tools/gen-plays.mjs: today's Daily Circuit in short landscape on a DPR-3 phone by keys, to its results.
# viewport 844x390@3
until 600 Daily Circuit
frames 30
save title
touch =Daily Circuit
until 300 Expected duration
frames 10
save setup
touch =Start
until 600 Hint
frames 60
save game
repeat 120000 until Watch Replay
key Enter 1
frames 20
end
frames 30
save results
